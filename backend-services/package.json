{
  "name": "smart-backend-services",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "generate-key": "node --env-file-if-exists=.env src/generate-key.ts",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\"",
    "fmt:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --deny-warnings src test"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "jose": "6.2.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
