{
  "name": "smart-backend-services",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "generate-key": "node --env-file-if-exists=.env --import tsx src/generate-key.ts",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
