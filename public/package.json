{
  "name": "smart-hackathon-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "node --watch --env-file=.env --import tsx src/main.ts",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\"",
    "fmt:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --deny-warnings src test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
